@model Client_WebApp.Models.AddInvoiceViewModel

<style>
    /* ── Amount Details table ── */
    #invAmountDetailsTable thead th {
        background: linear-gradient(90deg, #f0f4ff 0%, #e2eaff 100%);
        font-size: 0.82rem;
        font-weight: 600;
        color: #343a40;
        white-space: nowrap;
        vertical-align: middle;
    }
    #invAmountDetailsTable tbody tr:hover {
        background-color: #f8f9fa;
    }
    #invAmountDetailsTable .form-control-sm {
        font-size: 0.83rem;
        min-width: 100px;
    }
    .inv-row-num-cell {
        width: 36px;
        text-align: center;
        font-weight: 600;
        color: #6c757d;
    }
    .inv-action-cell {
        width: 46px;
        text-align: center;
    }
    /* ── Validation ── */
    .inv-field-error {
        display: block;
        color: #dc3545;
        font-size: 0.76rem;
        margin-top: 2px;
    }
    input.inv-invalid {
        border-color: #dc3545 !important;
    }
    /* ── Section headings ── */
    .inv-section-heading {
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .06em;
        color: #0d6efd;
        border-bottom: 2px solid #e9ecef;
        padding-bottom: 4px;
        margin-bottom: 14px;
    }
    /* ── Fancy Add More button ── */
    #inv-addMoreBtn {
        background: linear-gradient(135deg, #0d6efd 0%, #6610f2 100%);
        color: #fff;
        border: none;
        border-radius: 50px;
        padding: 6px 18px;
        font-size: 0.82rem;
        font-weight: 600;
        letter-spacing: .03em;
        box-shadow: 0 4px 14px rgba(13,110,253,.35);
        transition: transform .18s, box-shadow .18s, filter .18s;
    }
    #inv-addMoreBtn:hover {
        transform: translateY(-2px) scale(1.04);
        box-shadow: 0 7px 20px rgba(13,110,253,.5);
        filter: brightness(1.08);
    }
    #inv-addMoreBtn:active {
        transform: scale(0.97);
        box-shadow: 0 2px 8px rgba(13,110,253,.3);
    }
    #inv-addMoreBtn i {
        transition: transform .2s;
    }
    #inv-addMoreBtn:hover i {
        transform: rotate(90deg);
    }
    /* ── Misc ── */
    .cursor-pointer { cursor: pointer; }
    /* Delete row button */
    .inv-delete-btn {
        background: none;
        border: none;
        padding: 2px 6px;
        color: #dc3545;
        font-size: 1rem;
        cursor: pointer;
        border-radius: 4px;
        transition: background .15s, transform .15s;
        line-height: 1;
    }
    .inv-delete-btn:hover {
        background: rgba(220,53,69,.1);
        transform: scale(1.2);
        color: #a71d2a;
    }
    .inv-delete-btn:active {
        transform: scale(0.9);
    }
</style>

<div class="modal fade" id="invoice-modal" tabindex="-1" aria-labelledby="invoiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="invoiceModalLabel">Add Booking</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <form asp-action="CreateOrEdit" method="post" id="invoiceForm">
                @Html.AntiForgeryToken()

                <div class="modal-body">
                    <input asp-for="Id"        type="hidden" id="Id" />
                    <input asp-for="CompanyId" type="hidden" id="CompanyId" />
                    <input type="hidden" id="accordionItemsJson" name="accordionItemsJson" />
                    <!-- Legacy single-row binding fields -->
                    <input type="hidden" id="UnitAmount"  name="UnitAmount" />
                    <input type="hidden" id="Quantity"    name="Quantity" />
                    <input type="hidden" id="TotalAmount" name="TotalAmount" />
                    <input type="hidden" id="LRNumber"    name="LRNumber" />

                    <!-- ══════════════════════════════════════
                         SECTION 1: BOOKING DETAILS
                         ══════════════════════════════════════ -->
                    <p class="inv-section-heading mb-2">Booking Details</p>
                    <div class="row g-3 mb-4">

                        <div class="col-md-6">
                            <label asp-for="InvoiceDate" class="form-label fw-semibold"></label>
                            <input asp-for="InvoiceDate" class="form-control" type="date" id="InvoiceDate" />
                            <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Receipt Number</label>
                            <input asp-for="InvoiceNo" class="form-control" id="InvoiceNo" data-val="false" />
                        </div>

                        <div class="col-md-6">
                            <label asp-for="SubcontractorId" class="form-label fw-semibold"></label>
                            <select asp-for="SubcontractorId" class="form-select" asp-items="Model.SubContractorList">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="SubcontractorId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="ProductId" class="form-label fw-semibold"></label>
                            <select asp-for="ProductId" class="form-select" asp-items="Model.ProductList" id="ProductId">
                                <option value="">--Select--</option>
                            </select>
                            <span asp-validation-for="ProductId" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Discount</label>
                            <input asp-for="CommissionPercentage" class="form-control" id="CommissionPercentage" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Labour Charge</label>
                            <input asp-for="CommissionAmount" class="form-control" id="CommissionAmount" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Toli No</label>
                            <input asp-for="GroupNumber" class="form-control" id="GroupNumber" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Vehicle Number</label>
                            <input asp-for="VehicleNumber" class="form-control" id="VehicleNumber" />
                        </div>

                        <div class="col-md-6 d-flex flex-column justify-content-center">
                            <label class="form-label fw-semibold">Invoice Type</label>
                            <div class="d-flex gap-3 mt-1">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="PaymentMode" value="CASH" id="invoiceTypeCash" />
                                    <label class="form-check-label" for="invoiceTypeCash">Cash</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" asp-for="PaymentMode" value="BALANCE" id="invoiceTypeBalance" />
                                    <label class="form-check-label" for="invoiceTypeBalance">Balance</label>
                                </div>
                            </div>
                        </div>

                    </div><!-- /booking details row -->

                    <!-- ══════════════════════════════════════
                         SECTION 2: AMOUNT DETAILS TABLE
                         ══════════════════════════════════════ -->
                    <div class="d-flex align-items-center justify-content-between mb-2">
                        <p class="inv-section-heading mb-0">Amount Details</p>
                        <button type="button" id="inv-addMoreBtn">
                            <i class="bi bi-plus-lg me-1"></i> Add More
                        </button>
                    </div>

                    <div class="table-responsive">
                        <table class="table table-bordered table-sm align-middle mb-0" id="invAmountDetailsTable">
                            <thead>
                                <tr>
                                    <th class="inv-row-num-cell">#</th>
                                    <th>LR Number</th>
                                    <th>Unit Amount <span class="text-danger">*</span></th>
                                    <th>Quantity <span class="text-danger">*</span></th>
                                    <th>Total Amount <span class="text-danger">*</span></th>
                                    <th class="inv-action-cell"></th>
                                </tr>
                            </thead>
                            <tbody id="inv-amountBody">
                                <!-- rows injected by JS -->
                            </tbody>
                        </table>
                    </div>

                </div><!-- /modal-body -->

                <div class="modal-footer">
                    <button type="submit" class="btn btn-primary px-4" id="saveButton">
                        <i class="bi bi-save me-1"></i> Save
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
}

<script>
(function () {
    function waitForJQuery(cb) {
        if (typeof window.jQuery !== 'undefined') { cb(window.jQuery); }
        else { setTimeout(function () { waitForJQuery(cb); }, 30); }
    }

    waitForJQuery(function ($) {

        var rowCount = 0;

        /* ── Build a table row ── */
        function buildRow(data) {
            rowCount++;
            var id    = rowCount;
            var lr    = (data && data.lrNumber)    ? data.lrNumber    : '';
            var unit  = (data && data.unitAmount)  ? data.unitAmount  : '';
            var qty   = (data && data.quantity)    ? data.quantity    : '';
            var total = (data && data.totalAmount) ? data.totalAmount : '';

            return $(
                '<tr id="inv-row-' + id + '" data-row-id="' + id + '">' +
                  '<td class="inv-row-num-cell inv-row-num"></td>' +
                  '<td>' +
                    '<input type="text" class="form-control form-control-sm inv-lr-input" placeholder="LR Number" value="' + lr + '" />' +
                  '</td>' +
                  '<td>' +
                    '<input type="number" step="0.01" min="0.01" class="form-control form-control-sm inv-unit-input" placeholder="0.00" value="' + unit + '" />' +
                    '<span class="inv-field-error" style="display:none;"></span>' +
                  '</td>' +
                  '<td>' +
                    '<input type="number" step="0.01" min="0.01" class="form-control form-control-sm inv-qty-input" placeholder="0" value="' + qty + '" />' +
                    '<span class="inv-field-error" style="display:none;"></span>' +
                  '</td>' +
                  '<td>' +
                    '<input type="number" step="0.01" class="form-control form-control-sm inv-total-input" placeholder="0.00" value="' + total + '" readonly />' +
                    '<span class="inv-field-error" style="display:none;"></span>' +
                  '</td>' +
                  '<td class="inv-action-cell" style="text-align:center;vertical-align:middle;">' +
                    '<button type="button" class="inv-delete-btn" title="Remove this row">' +
                      '<i class="fa fa-trash"></i>' +
                    '</button>' +
                  '</td>' +
                '</tr>'
            );
        }

        /* ── Re-number rows and re-index field names ── */
        function refreshRows() {
            $('#inv-amountBody tr').each(function (i) {
                $(this).find('.inv-row-num').text(i + 1);
                $(this).find('.inv-lr-input').attr('name',    'LRItems[' + i + '].LRNumber');
                $(this).find('.inv-unit-input').attr('name',  'LRItems[' + i + '].UnitAmount');
                $(this).find('.inv-qty-input').attr('name',   'LRItems[' + i + '].Quantity');
                $(this).find('.inv-total-input').attr('name', 'LRItems[' + i + '].TotalAmount');
            });
        }

        /* ── Add a row ── */
        function addRow(data) {
            var $row = buildRow(data);
            $('#inv-amountBody').append($row);
            refreshRows();
        }

        /* ── Init: first row ── */
        addRow(null);

        /* ── Add More button ── */
        $('#inv-addMoreBtn').on('click', function () {
            addRow(null);
            var lastRow = $('#inv-amountBody tr').last()[0];
            if (lastRow) lastRow.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });

        /* ── Delete row ── */
        $(document).on('click', '.inv-delete-btn', function () {
            if ($('#inv-amountBody tr').length <= 1) {
                alert('At least one amount detail row is required.');
                return;
            }
            $(this).closest('tr').remove();
            refreshRows();
        });

        /* ── Auto-calculate Total = Unit × Qty; clear field errors ── */
        $(document).on('input', '.inv-unit-input, .inv-qty-input', function () {
            var $row   = $(this).closest('tr');
            var unit   = parseFloat($row.find('.inv-unit-input').val()) || 0;
            var qty    = parseFloat($row.find('.inv-qty-input').val())  || 0;
            var total  = unit * qty;
            $row.find('.inv-total-input').val(total > 0 ? total.toFixed(2) : '');

            /* Clear error on changed field */
            $(this).removeClass('inv-invalid');
            $(this).siblings('.inv-field-error').hide().text('');

            /* Clear total error if now valid */
            if (total > 0) {
                $row.find('.inv-total-input').removeClass('inv-invalid');
                $row.find('.inv-total-input').siblings('.inv-field-error').hide().text('');
            }
        });

        /* ── Validate all rows ── */
        function validateRows() {
            var isValid = true;

            /* Reset all row errors */
            $('#inv-amountBody .inv-unit-input, #inv-amountBody .inv-qty-input, #inv-amountBody .inv-total-input')
                .removeClass('inv-invalid');
            $('#inv-amountBody .inv-field-error').hide().text('');

            $('#inv-amountBody tr').each(function () {
                var $row  = $(this);
                var $unit = $row.find('.inv-unit-input');
                var $qty  = $row.find('.inv-qty-input');
                var $tot  = $row.find('.inv-total-input');

                var unitVal = parseFloat($unit.val()) || 0;
                var qtyVal  = parseFloat($qty.val())  || 0;
                var totVal  = parseFloat($tot.val())  || 0;

                if (!$unit.val().trim() || unitVal <= 0) {
                    $unit.addClass('inv-invalid');
                    $unit.siblings('.inv-field-error').show().text('Required, must be > 0');
                    isValid = false;
                }
                if (!$qty.val().trim() || qtyVal <= 0) {
                    $qty.addClass('inv-invalid');
                    $qty.siblings('.inv-field-error').show().text('Required, must be > 0');
                    isValid = false;
                }
                if (totVal <= 0) {
                    $tot.addClass('inv-invalid');
                    $tot.siblings('.inv-field-error').show().text('Must be > 0 (enter Unit Amount & Quantity)');
                    isValid = false;
                }
            });

            return isValid;
        }

        /* ── Form submit ── */
        $('#invoiceForm').off('submit').on('submit', function (e) {
            e.preventDefault();

            if (!validateRows()) {
                var $first = $('#inv-amountBody .inv-invalid').first();
                if ($first.length) $first[0].scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            /* Gather rows into JSON */
            var rows = [];
            $('#inv-amountBody tr').each(function () {
                rows.push({
                    lrNumber:    $(this).find('.inv-lr-input').val(),
                    unitAmount:  $(this).find('.inv-unit-input').val(),
                    quantity:    $(this).find('.inv-qty-input').val(),
                    totalAmount: $(this).find('.inv-total-input').val()
                });
            });
            $('#accordionItemsJson').val(JSON.stringify(rows));

            /* Map first row to legacy single-model hidden fields */
            if (rows.length > 0) {
                $('#UnitAmount').val(rows[0].unitAmount);
                $('#Quantity').val(rows[0].quantity);
                $('#TotalAmount').val(rows[0].totalAmount);
                $('#LRNumber').val(rows[0].lrNumber);
            }

            var form = $(this);
            $.ajax({
                url:  form.attr('action'),
                type: 'POST',
                data: form.serialize(),
                success: function (result) {
                    if (result.success) {
                        try {
                            if (typeof $ === 'function' && typeof $.fn.modal === 'function') {
                                $('#invoice-modal').modal('hide');
                            } else {
                                var closeBtn = document.querySelector('#invoice-modal [data-bs-dismiss="modal"]');
                                if (closeBtn) closeBtn.click();
                            }
                        } catch (e) {
                            var closeBtn = document.querySelector('#invoice-modal [data-bs-dismiss="modal"]');
                            if (closeBtn) closeBtn.click();
                        }
                        localStorage.setItem('toastMessage', result.message);
                        window.location.href = '/Invoice/Index';
                        location.reload();
                    } else {
                        alert(result.message);
                    }
                },
                error: function (err) {
                    console.error(err);
                    alert('Something went wrong');
                }
            });
        });

    }); /* end waitForJQuery */
})();
</script>
