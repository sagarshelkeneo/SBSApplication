@{
    ViewData["Title"] = "Home";
    var role = ViewBag.UserRole as string;
    bool hasReportAccess = role == "Super Admin" || role == "Admin" || role == "Manager" || role == "report_user";
}

<link rel="stylesheet" href="~/css/home.css" />
<div id="home">
    @if (hasReportAccess)
    {
        <div class="card m-3" style="width: 18rem;">
            <div class="card-body">
                <a asp-controller="Report" asp-action="ContractorReport">Contractor Report <i class="fa-solid fa-file-zipper icon"></i></a>
            </div>
        </div>

        <div class="card m-3" style="width: 18rem;">
            <div class="card-body">
                <a asp-controller="Report" asp-action="ProfitLossReport">Profit & Loss Report <i class="fa-solid fa-file-zipper icon"></i></a>
            </div>
        </div>
       
        <div class="card m-3" style="width: 18rem;">
        </div>

        <div class="card m-3" style="width: 18rem;">
            <div class="card-body">
                <a asp-controller="Report" asp-action="ContractorLegrandReport">Legrand Contractor Report <i class="fa-solid fa-file-zipper icon"></i></a>
            </div>
        </div>

        <div class="card m-3" style="width: 18rem;">
            <div class="card-body">
                <a asp-controller="Report" asp-action="ProfitLossLegrandReport">Legrand Profit & Loss Report <i class="fa-solid fa-file-zipper icon"></i></a>
            </div>
        </div>
        <div class="card m-3" style="width: 18rem;">
        </div>
    }
</div>
