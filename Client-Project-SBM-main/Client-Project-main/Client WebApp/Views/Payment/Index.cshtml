@model Client_WebApp.Models.PaymentIndexViewModel
@{
    ViewData["Title"] = "Bank Payments";
}

@* <h2 class="pt-4 fs-1">Payments</h2> *@

<div class="">

    <!-- Add / Export Buttons -->
    <div class="my-3">
        <button class="btn btn-outline-primary mb-2" data-bs-toggle="modal" data-bs-target="#payment-modal" onclick="setModalMode('add')">
            <i class="fa-solid fa-plus"></i> Add
        </button>
        <button class="btn btn-outline-danger mb-2" onclick="exportToPdf()">
            <i class="fa-solid fa-file-pdf"></i> Export PDF
        </button>
        <button class="btn btn-outline-success mb-2" onclick="exportToExcel()">
            <i class="fa-solid fa-file-excel"></i> Export Excel
        </button>
    </div>

    <!-- Filters -->
    <div class="card mb-2">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-12">
                    <label class="form-label d-block">Filter Type</label>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="durationType" value="day" @(ViewData["DurationType"]?.ToString() == "day" ? "checked" : "") onchange="toggleFilter('day')">
                        <label class="form-check-label">Day</label>
                    </div>
                    <div class="form-check form-check-inline">
                        <input class="form-check-input" type="radio" name="durationType" value="date" @(ViewData["DurationType"]?.ToString() == "date" ? "checked" : "") onchange="toggleFilter('date')">
                        <label class="form-check-label">Duration</label>
                    </div>
                </div>

                <div class="col-md-3" id="dayDiv">
                    <label>Payment Date</label>
                    <input type="date" name="dayDate" class="form-control" value="@ViewData["DayDate"]" />
                </div>

                <div class="col-md-3 d-none" id="fromDiv">
                    <label>From</label>
                    <input type="date" name="fromDate" class="form-control" value="@ViewData["FromDate"]" />
                </div>
                <div class="col-md-3 d-none" id="toDiv">
                    <label>To</label>
                    <input type="date" name="toDate" class="form-control" value="@ViewData["ToDate"]" />
                </div>

                <div class="col-md-3">
                    <label>Search</label>
                    <input type="text" name="bankName" class="form-control" placeholder="Search" value="@ViewData["BankName"]" />
                </div>

                <div class="col-auto">
                    <button type="submit" class="btn btn-outline-primary">Search</button>
                    <a href="@Url.Action("Index", new { companyId = Model.CompanyId })" class="btn btn-outline-secondary">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Payment Table -->
    <div class="card mb-4">
        <div class="card-header">
            <i class="fas fa-table me-1"></i>
            Bank Payments Table
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover dataTable" id="paymentTable">
                    <thead class="thead-dark">
                        <tr>
                            <th>Sr. No.</th>
                            <th>Payment Date</th>
                            <th>Invoice No.</th>
                            <th>Sub Contractor</th>
                            <th>Bank Name</th>
                            <th>Amount Paid</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Payments != null && Model.Payments.Any())
                        {
                            foreach (var payment in Model.Payments)
                            {
                                <tr data-payment-id="@payment.Id">
                                    <td>@payment.Id</td>
                                    <td class="text-end">
                                        @(payment.DurationType == "day"
                                            ? payment.PaymentDate?.ToString("dd-MMM-yy")
                                            : $"{payment.FromDate?.ToString("dd-MMM-yy")} - {payment.ToDate?.ToString("dd-MMM-yy")}")
                                    </td>
                                    <td>@payment.InvoiceNo</td>
                                    <td>@payment.SubContractorName</td>
                                    <td>@(string.IsNullOrEmpty(payment.BankName) ? "-" : payment.BankName)</td>
                                    <td>@payment.AmountPaid.ToString("N2")</td>
                                    <td>
                                        <div class="action-icons">
                                            <i class="fa-regular fa-eye cursor-pointer text-success"></i>
                                            <i class="fa-regular fa-pen-to-square cursor-pointer"></i>
                                            <i class="fa-solid fa-trash cursor-pointer text-danger"></i>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                    @if (Model.Payments != null && Model.Payments.Any())
                    {
                        decimal totalAmountPaid = Model.Payments.Sum(x => x.AmountPaid);

                        <tfoot>
                            <tr>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td></td>
                                <td class="text-end fw-bold">Total</td>
                                <td class="text-end fw-bold">@totalAmountPaid.ToString("N2")</td>
                                <td></td>
                            </tr>
                        </tfoot>
                    }
                </table>
            </div>
        </div>
    </div>

    <div>
        @{
            await Html.RenderPartialAsync("_PaymentModal", Model.AddPaymentViewModel);
        }
    </div>
</div>

@section Scripts {
     <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script> 
     <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf-autotable/3.5.25/jspdf.plugin.autotable.min.js"></script>
     <script src="https://cdn.sheetjs.com/xlsx-latest/package/dist/xlsx.full.min.js"></script>
     <!-- Select2 CSS & JS -->
    <!-- Select2 CSS & JS -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- DataTables CSS -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <!-- DataTables JS -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script>
        const paymentModal = document.getElementById("payment-modal");

        $(document).ready(function () {
            if (typeof $.validator !== 'undefined') {
                $.validator.setDefaults({
                    ignore: ":hidden, .select2-search__field",
                    onkeyup: false,
                    onclick: false,
                    onfocusout: false
                });
                const $form = $('#paymentForm');
                if ($form.length && $form.data('validator')) {
                    $form.data('validator').settings.ignore = ":hidden, .select2-search__field";
                    $form.data('validator').settings.onkeyup = false;
                    $form.data('validator').settings.onclick = false;
                    $form.data('validator').settings.onfocusout = false;
                }
            }

            initializeGenericDataTable({
                tableSelector: '#paymentTable',
                customInfoId: 'paymentTable_info_custom',
                columnDefs: [
                    { orderable: false, targets: 0 },
                    { orderable: false, targets: -1 },
                    { type: 'date', targets: 1 }
                ],
                columnsSearchable: [false, true, true,true, true, true, false],
                order: [[1, 'desc']],
                actionCallbacks: {
                    '.fa-eye': viewPayment,
                    '.fa-pen-to-square': editPayment,
                    '.fa-trash': function(id) { showDeleteModal(id, '/Payment/DeletePayment'); }
                }
            });

            //Action icons
            $('#paymentTable tbody').on('click', '.fa-eye', function () {
                var id = $(this).closest('tr').data('payment-id');
                viewPayment(id);
            });
            $('#paymentTable tbody').on('click', '.fa-pen-to-square', function () {
                var id = $(this).closest('tr').data('payment-id');
                editPayment(id);
            });
            $('#paymentTable tbody').on('click', '.fa-trash', function () {
                var id = $(this).closest('tr').data('payment-id');
                showDeleteModal(id, '/Payment/DeletePayment');
            });
        });

        // Toggle filters dynamically
        function toggleFilterDuration(type) {
            const dayDiv = document.getElementById("filterDayDiv");
            const fromDiv = document.getElementById("filterFromDiv");
            const toDiv = document.getElementById("filterToDiv");

            if (type === "day") {
                dayDiv.classList.remove("d-none");
                fromDiv.classList.add("d-none");
                toDiv.classList.add("d-none");
            } else {
                dayDiv.classList.add("d-none");
                fromDiv.classList.remove("d-none");
                toDiv.classList.remove("d-none");
            }
        }


        function toggleModalPaymentDuration(type) {
            if (type === "day") {
                $("#modalPaymentDateDiv").removeClass("d-none");
                $("#modalFromDateDiv, #modalToDateDiv").addClass("d-none");
            } else {
                $("#modalPaymentDateDiv").addClass("d-none");
                $("#modalFromDateDiv, #modalToDateDiv").removeClass("d-none");
            }
        }

         function toggleModalInvoiceType(type) {
            $('#invoiceSelectValMsg, #subContractorSelectValMsg').addClass('d-none');
            if (type === "invoice") {
                $("#modalSubContractorDiv").addClass("d-none");
                $("#modalInvoiceDiv").removeClass("d-none");
            } else {
                $("#modalSubContractorDiv").removeClass("d-none");
                $("#modalInvoiceDiv").addClass("d-none");
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const radios = document.querySelectorAll('input[name="ModalDurationType"]');
            radios.forEach(radio => {
                radio.addEventListener('change', function () {
                    toggleModalPaymentDuration(this.value);
                });
            });
        });

         document.addEventListener("DOMContentLoaded", function () {
            const radios = document.querySelectorAll('input[name="ModalInvoiceType"]');
            radios.forEach(radio => {
                radio.addEventListener('change', function () {
                    toggleModalInvoiceType(this.value);
                });
            });
        });

        // When modal opens, ensure correct view
        paymentModal.addEventListener("shown.bs.modal", function () {
            const checkedRadio = paymentModal.querySelector('input[name="ModalDurationType"]:checked');
            toggleModalPaymentDuration(checkedRadio ? checkedRadio.value : 'day');
        });

        // When modal opens, ensure correct view
        paymentModal.addEventListener("shown.bs.modal", function () {
            const checkedRadio = paymentModal.querySelector('input[name="ModalInvoiceType"]:checked');
            toggleModalInvoiceType(checkedRadio ? checkedRadio.value : 'invoice');
        });

        paymentModal.addEventListener("hidden.bs.modal", function () {
            resetForm('#paymentForm');

            $('#modalInvoiceRadio').prop('checked', true);
            $('#modalDayRadio').prop('checked', true);
            toggleModalPaymentDuration('day');
            toggleModalInvoiceType('invoice');

            $('#PaymentDate').val(new Date().toISOString().substring(0, 10)); // default today
            $('#FromDate').val('');
            $('#ToDate').val('');
            $('#AmountPaid').val('');
            $('#BankId').val('').trigger('change');

            $('#modalInvoicesContainer').addClass('d-none');
            $('#modalInvoicesTbody').empty();
            $('#modalInvoicesCount').text('0 Invoices');
            $('#modalInvoicesTotalSum').text('Total: 0.00');
            $('#modalInvoiceSearch').val('');
            $('#invoiceSelectValMsg, #subContractorSelectValMsg').addClass('d-none');
            $('#toggleInvoicesIcon').removeClass('fa-eye-slash').addClass('fa-eye');
        });

        // Hide validation messages on dropdown selection change
        $(document).off('change', '#invoiceSelect').on('change', '#invoiceSelect', function () {
            if ($(this).val()) $('#invoiceSelectValMsg').addClass('d-none');
        });
        $(document).off('change', '#subContractorSelect').on('change', '#subContractorSelect', function () {
            if ($(this).val()) $('#subContractorSelectValMsg').addClass('d-none');
        });

        // Toggle Invoice List visibility button
        $(document).off('click', '#btnToggleInvoices').on('click', '#btnToggleInvoices', function () {
            const container = $('#modalInvoicesContainer');
            const icon = $('#toggleInvoicesIcon');

            if (container.hasClass('d-none')) {
                container.removeClass('d-none');
                icon.removeClass('fa-eye').addClass('fa-eye-slash');
            } else {
                container.addClass('d-none');
                icon.removeClass('fa-eye-slash').addClass('fa-eye');
            }
        });

        // Live filter for modal invoice table by invoice number
        $(document).off('keyup input', '#modalInvoiceSearch').on('keyup input', '#modalInvoiceSearch', function () {
            const query = $(this).val().toLowerCase().trim();
            let visibleCount = 0;
            let visibleSum = 0;

            $('#modalInvoicesTbody tr').each(function () {
                const row = $(this);
                const invNoTd = row.find('td:first-child').text().toLowerCase();
                const amtTdStr = row.find('td:last-child').text().replace(/,/g, '');
                const amtTd = parseFloat(amtTdStr) || 0;

                if (!query || invNoTd.includes(query)) {
                    row.removeClass('d-none');
                    visibleCount++;
                    visibleSum += amtTd;
                } else {
                    row.addClass('d-none');
                }
            });

            const total = $('#modalInvoicesTbody tr').length;
            if (query) {
                $('#modalInvoicesCount').text(`${visibleCount} of ${total} Invoices`);
            } else {
                $('#modalInvoicesCount').text(`${total} Invoice${total > 1 ? 's' : ''}`);
            }

            $('#modalInvoicesTotalSum').text('Total: ' + visibleSum.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
        });

        // Get Invoices AJAX button handler
        $(document).off('click', '#btnGetInvoices').on('click', '#btnGetInvoices', function () {
            $('#invoiceSelectValMsg, #subContractorSelectValMsg').addClass('d-none');

            const invoiceType = $('input[name="ModalInvoiceType"]:checked').val() || 'invoice';
            const invoiceId = $('#invoiceSelect').val() || null;
            const subContractorId = $('#subContractorSelect').val() || null;

            if (invoiceType === 'invoice' && !invoiceId) {
                $('#invoiceSelectValMsg').removeClass('d-none');
                $('#invoiceSelect').focus();
                return;
            }

            if (invoiceType === 'subcontractor' && !subContractorId) {
                $('#subContractorSelectValMsg').removeClass('d-none');
                $('#subContractorSelect').focus();
                return;
            }

            if (!invoiceId && !subContractorId) {
                if (invoiceType === 'invoice') {
                    $('#invoiceSelectValMsg').removeClass('d-none');
                    $('#invoiceSelect').focus();
                } else {
                    $('#subContractorSelectValMsg').removeClass('d-none');
                    $('#subContractorSelect').focus();
                }
                return;
            }

            const paymentDate = $('#PaymentDate').val() || null;
            const fromDate = $('#FromDate').val() || null;
            const toDate = $('#ToDate').val() || null;

            const btn = $(this);
            const originalHtml = btn.html();
            btn.prop('disabled', true).html('<i class="fa-solid fa-spinner fa-spin me-1"></i> Loading...');

            $.ajax({
                url: '/Invoice/GetInvoices',
                type: 'GET',
                data: {
                    invoiceId: invoiceId,
                    subContractorId: subContractorId,
                    paymentDate: paymentDate,
                    fromDate: fromDate,
                    toDate: toDate,
                    isLeviApplicable: false
                },
                success: function (res) {
                    btn.prop('disabled', false).html(originalHtml);
                    if (res.success && res.data) {
                        renderModalInvoices(res.data);
                    } else {
                        alert('No invoices found or error: ' + (res.message || 'Unknown error'));
                    }
                },
                error: function () {
                    btn.prop('disabled', false).html(originalHtml);
                    alert('Failed to fetch invoices.');
                }
            });
        });

        function renderModalInvoices(invoices) {
            const tbody = $('#modalInvoicesTbody');
            tbody.empty();
            $('#modalInvoiceSearch').val('');

            if (!invoices || invoices.length === 0) {
                tbody.append('<tr><td colspan="3" class="text-center text-muted py-3">No invoices found for selected parameters.</td></tr>');
                $('#modalInvoicesCount').text('0 Invoices');
                $('#modalInvoicesTotalSum').text('Total: 0.00');
                $('#modalInvoicesContainer').removeClass('d-none');
                return;
            }

            let totalSum = 0;
            invoices.forEach(function (inv) {
                //const invNo = inv.invoiceNo || inv.InvoiceNo || inv.invoiceId || inv.InvoiceId || inv.receiptNumber || inv.ReceiptNumber || inv.r_invoiceNo || inv.R_invoiceNo || inv.id || '-';
                const invNo = inv.invoiceNo;
                let invDate = '-';
                const rawDate = inv.invoiceDate ;
                //const rawDate = inv.invoiceDate || inv.InvoiceDate || inv.paymentDate || inv.PaymentDate || inv.fromDate || inv.FromDate;
                if (rawDate) {
                    const d = new Date(rawDate);
                    if (!isNaN(d.getTime())) {
                        invDate = d.toLocaleDateString('en-GB');
                    }
                }

                const rawAmount = inv.totalAmount;
                const amtVal = parseFloat(rawAmount) || 0;
                totalSum += amtVal;
                const amountStr = amtVal.toFixed(2);

                const tr = `<tr>
                    <td class="fw-semibold text-dark">${invNo}</td>
                    <td>${invDate}</td>
                    <td class="text-end fw-bold text-primary">${amountStr}</td>
                </tr>`;
                tbody.append(tr);
            });

            $('#modalInvoicesCount').text(invoices.length + ' Invoice' + (invoices.length > 1 ? 's' : ''));
            $('#modalInvoicesTotalSum').text('Total: ' + totalSum.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }));
            $('#modalInvoicesContainer').removeClass('d-none');
            $('#toggleInvoicesIcon').removeClass('fa-eye').addClass('fa-eye-slash');
        }

        function setModalMode(mode) {
            const modalLabel = document.getElementById("paymentModalLabel");

            if (mode === 'add') {
                modalLabel.innerText = 'Add Bank Payments';
                $('#paymentForm input, #paymentForm select').prop('disabled', false);
                $('#modalSaveButton').show();
            }
            else if (mode === 'edit') {
                modalLabel.innerText = 'Edit Bank Payments';
                $('#paymentForm input, #paymentForm select').prop('disabled', false);
                $('#modalSaveButton').show();
            }
            else if (mode === 'view') {
                modalLabel.innerText = 'View Bank Payments';
                $('#paymentForm input, #paymentForm select').prop('disabled', true);
                $('#modalSaveButton').hide();
            }
        }

        function getPayment(id, mode) {
            $.ajax({
                url: `/Payment/GetPayment?id=${id}`,
                type: 'GET',
                success: function (data) {
                    // Populate form fields
                    $('#Id').val(data.id);
                    $('#CompanyId').val(data.companyId);

                    // Invoice select (Select2) fix
                    $('#invoiceSelect').val(data.invoiceNo).trigger('change');
                    $('#subContractorSelect').val(data.subContractorId).trigger('change');

                    $('#AmountPaid').val(data.amountPaid);
                    $('#BankId').val(data.bankId).trigger('change');
                    $('#PaymentDate').val(data.paymentDate?.substring(0, 10));
                    $('#FromDate').val(data.fromDate?.substring(0, 10));
                    $('#ToDate').val(data.toDate?.substring(0, 10));

                    // Duration type
                    if (data.durationType === "day") {
                        $('#modalDayRadio').prop('checked', true);
                        $('#modalDurationRadio').prop('checked', false);
                    } else {
                        $('#modalDayRadio').prop('checked', false);
                        $('#modalDurationRadio').prop('checked', true);
                    }
                    console.log(data.invoiceType);
                    console.log(data);
                    // Invoice type
                    if (data.invoiceType === "invoice") {
                        $('#modalInvoiceRadio').prop('checked', true);
                        $('#modalSubContractorRadio').prop('checked', false);
                    } else {
                        $('#modalInvoiceRadio').prop('checked', false);
                        $('#modalSubContractorRadio').prop('checked', true);
                    }


                    toggleModalPaymentDuration(data.durationType);
                    toggleModalInvoiceType(data.invoiceType);

                    // set mode
                    setModalMode(mode);

                    // Show modal
                    $('#payment-modal').modal('show');
                },
                error: function () {
                    alert("Failed to load payment data.");
                }
            });
        }

        // Trigger functions
        function editPayment(id) {
            getPayment(id, 'edit');
        }

        function viewPayment(id) {
            getPayment(id, 'view');
        }

        function toggleFilter(type) {
            if (type === 'day') {
                $('#dayDiv').removeClass('d-none');
                $('#fromDiv, #toDiv').addClass('d-none');
            } else {
                $('#dayDiv').addClass('d-none');
                $('#fromDiv, #toDiv').removeClass('d-none');
            }
        }

        // Initialize filter on page load
        $(function() {
            toggleFilter('@ViewData["DurationType"]');
        });
    </script>
}
