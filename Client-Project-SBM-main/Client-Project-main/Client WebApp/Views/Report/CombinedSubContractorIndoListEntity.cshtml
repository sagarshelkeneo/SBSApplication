@using Client.Application.Features.PaymentReports.Dtos
@model List<CombinedSubcontractorReportDto>

@{
    ViewData["Title"] = "Indo Levhi Details";
}

@* <h2 class="pt-4 fs-1">Combined Sub-Contractor Entity Reports</h2> *@

<div class="">

    <!-- Export Buttons -->
    <div class="d-flex justify-content-between flex-wrap my-3">
        <div>
            <button class="btn btn-outline-danger mb-2" onclick="exportToPdfReport()">
                <i class="fa-solid fa-file-pdf"></i> Export PDF
            </button>
            <button class="btn btn-outline-success mb-2" onclick="exportToExcelReport()">
                <i class="fa-solid fa-file-excel"></i> Export Excel
            </button>
            <button class="btn btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filter-container">
                Filters <i class="fa-solid fa-angle-down"></i>
            </button>
        </div>
    </div>

    <div class="card mb-3 shadow-sm">
        <div class="card-body collapse @(ViewContext.HttpContext.Request.Query.Any() ? "show" : "")" id="filter-container">
            <form method="get" class="row g-3" asp-action="CombinedSubContractorIndoListEntity">
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@(ViewContext.HttpContext.Request.Query["fromDate"])" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@(ViewContext.HttpContext.Request.Query["toDate"])" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Customer Name</label>
                    <input type="text" name="subcontractorName" class="form-control" placeholder="Sub-Contractor Name" value="@(ViewContext.HttpContext.Request.Query["subcontractorName"])" />
                </div>
                <div class="col-md-12 mt-2">
                    <button type="submit" class="btn btn-outline-primary mb-2 me-2">Search</button>
                    <a asp-action="Paid" class="btn btn-outline-secondary mb-2">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Report Table Section --> 
    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <i class="fas fa-table me-1"></i> Indo Levhi Details
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-bordered table-striped table-hover align-middle dataTable" id="reportTable">
                    <thead class="text-center">
                        <tr>
                            <th>Sr. No.</th>
                            <th>Date</th>
                            <th>Docket Number</th>
                            <th>Invoice Number</th>
                            <th>Customer</th>
                            <th>Quantity</th>
                            <th>Total Amount</th>
                            <th>Levhi Amount</th>
                            <th>Final Amount</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model != null && Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                <tr>
                                    <td class="text-center"></td>
                                    <td>
                                        @(DateTime.TryParse(item.Date, out var dateVal)
                                            ? dateVal.ToString("dd-MMM-yyyy")
                                            : item.Date)
                                    </td>
                                    <td>@item.DocketNumber</td>
                                    <td>@item.InvoiceNo</td>
                                    <td>@item.Customer</td>
                                    @* <td class="text-end">@(decimal.TryParse(item.Quantity, out var qtyVal) ? qtyVal.ToString("N0") : "0") </td> *@
                                    <td class="text-end">@item.Quantity</td>
                                    <td class="text-end">@item.TotalAmount</td>
                                    <td class="text-end">@item.LevhiAmount</td>
                                    <td class="text-end text-success fw-semibold">@item.FinalAmount</td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="9" class="text-center fs-5 text-danger">No Records Found</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initializeGenericDataTable({
                tableSelector: '#reportTable',
                customInfoId: 'reportTable_info_custom',
                columnDefs: [
                    { orderable: false, targets: 0 }
                ],
                columnsSearchable: [false, true, true, true, true, true, true, true, true],
                order: [[0, 'asc']],
                destroy: true,
                language: { emptyTable: "No Records Found" }
            });
        });
    </script>
}
