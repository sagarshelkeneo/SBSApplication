@using Client.Application.Features.PaymentReports.Dtos
@model List<PaidReportDto>

@{
    ViewData["Title"] = "Contractor Details";
}

@* <h2 class="pt-4 fs-1">Paid Reports</h2> *@

<div class="pt-3 px-3 pb-2">

    <!-- Export Buttons -->
    <div class="mb-3">
        <button class="btn btn-outline-danger mb-2" onclick="exportToPdfReport()">
            <i class="fa-solid fa-file-pdf"></i> Export PDF
        </button>
        <button class="btn btn-outline-success mb-2" onclick="exportToExcelReport()">
            <i class="fa-solid fa-file-excel"></i> Export Excel
        </button>
        <button class="btn btn-outline-primary mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#filter-container">
            Filters <i class="fa-solid fa-angle-down"></i>
        </button>
    </div>

    <!-- Filter Section -->
    <div class="card mb-3 shadow-sm">
        <div class="card-body collapse @(ViewContext.HttpContext.Request.Query.Any() ? "show" : "")" id="filter-container">
            <form method="get" class="row g-3" asp-action="ContractorReport">
                <div class="col-md-3">
                    <label class="form-label">From Date</label>
                    <input type="date" name="fromDate" class="form-control" value="@(ViewContext.HttpContext.Request.Query["fromDate"])" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">To Date</label>
                    <input type="date" name="toDate" class="form-control" value="@(ViewContext.HttpContext.Request.Query["toDate"])" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Sub-Contractor Name</label>
                    <input type="text" name="subcontractorName" class="form-control" placeholder="Sub-Contractor Name" value="@(ViewContext.HttpContext.Request.Query["subcontractorName"])" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Search Invoice No|LR No|Vehicle No</label>
                    <input type="text" name="bankName" class="form-control" placeholder="Search" value="@(ViewContext.HttpContext.Request.Query["bankName"])" />
                </div>
                <div class="col-md-12 mt-2">
                    <button type="submit" class="btn btn-outline-primary mb-2 me-2">Search</button>
                    <a asp-action="Paid" class="btn btn-outline-secondary mb-2">Reset</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Report Table -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header">
            <i class="fas fa-table me-1"></i> Contractor Report
        </div>
        <div class="card-body table-responsive">
            <table class="table table-bordered table-striped table-hover align-middle text-nowrap" id="reportTable">
                <thead class="text-center">
                    <tr>
                        <th>Sr. No.</th>
                        <th>Invoice Date</th>
                        <th>Receipt Number</th>
                        <th>LR Number</th>
                        <th>Vehicle Number</th>
                        <th>Sub-Contractor</th>
                        
                        <th>Box</th>
                        <th>Peti</th>
                        <th>Motor</th>
                        <th>Total Type Rate</th>
                        <th class="text-end">Total Amount</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        for (int i = 0; i < Model.Count; i++)
                        {
                            var item = Model[i];

                            <tr>
                                <td class="text-center"></td>
                                <td>@(item.InvoiceDate?.ToString("dd-MMM-yy") ?? "-")</td>
                                <td>@item.ReceiptNumber</td>
                                <td>@item.LRNumber</td>
                                <td>@item.VehicleNumber</td>
                                <td>@item.SubContractor</td>

                                <td>@(item.Box ?? "-")</td>
                                <td>@(item.Peti ?? "-")</td>
                                <td>@(item.Motors ?? "-")</td>                                
                                <td>@item.TotalTypeRate</td>
                                <td class="text-end fw-semibold">@item.InvoiceAmount.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
                @if (Model != null && Model.Any())
                {
                    decimal totalAmount = Model.Sum(x => x.InvoiceAmount);
                    int totalBox = Model.Sum(x => int.TryParse(x.Box, out int b) ? b : 0);
                    int totalPeti = Model.Sum(x => int.TryParse(x.Peti, out int p) ? p : 0);
                    int totalMotors = Model.Sum(x => int.TryParse(x.Motors, out int m) ? m : 0);
                    decimal totalTypeRate = Model.Sum(x => decimal.TryParse(x.TotalTypeRate, out decimal r) ? r : 0);

                    <tfoot>
                        <tr>
                            <td colspan="6" class="text-end fw-bold">Total</td>
                            <td class="text-end fw-bold">@(totalBox > 0 ? totalBox.ToString() : "-")</td>
                            <td class="text-end fw-bold">@(totalPeti > 0 ? totalPeti.ToString() : "-")</td>
                            <td class="text-end fw-bold">@(totalMotors > 0 ? totalMotors.ToString() : "-")</td>
                            <td class="text-end fw-bold">@(totalTypeRate > 0 ? totalTypeRate.ToString("N2") : "-")</td>
                            <td class="text-end fw-bold">@totalAmount.ToString("N2")</td>
                        </tr>
                    </tfoot>
                }
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            initializeGenericDataTable({
                tableSelector: '#reportTable',
                customInfoId: 'reportTable_info_custom',
                columnDefs: [{ orderable: false, targets: 0 }],
                columnsSearchable: [false, true, true, true, true, true, true, true, true, true, true],
                order: [[1, 'asc']],
                destroy: true,
                language: { emptyTable: "No Records Found" }
            });
        });
    </script>
}
