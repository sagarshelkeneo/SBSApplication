@{
    ViewData["Title"] = "Dashboard";
    var role = ViewBag.UserRole as string;
    bool hasReportAccess = role == "Super Admin" || role == "Admin" || role == "Manager" || role == "report_user" || role == "data_user";
}

<link rel="stylesheet" href="~/css/home.css" />

<div class="executive-dashboard py-4 px-3">
    <div class="container">
        <!-- Header -->
        <header class="dashboard-header">
            <div class="title-area">
                <h1>Dashboard</h1>
                <p>Access realtime analytics, operational breakdowns, and balance sheets.</p>
            </div>
            <div class="search-bar">
                <div class="search-input-wrapper">
                    <i class="fa-solid fa-magnifying-glass search-icon"></i>
                    <input type="text" id="reportSearchInput" placeholder="Search reports..." />
                </div>
            </div>
        </header>

        @if (hasReportAccess)
        {
            <!-- SECTION 1: Standard Group -->
            <section class="group-section std-group">
                <div class="group-header">
                    <div class="group-header-left">
                        <div class="group-title-icon">
                            <i class="fa-solid fa-layer-group"></i>
                        </div>
                        <h2>Standard Reports</h2>
                    </div>
                    <span class="badge">2 Modules</span>
                </div>

                <div class="grid">
                    <!-- Contractor Report -->
                    <a asp-controller="Report" asp-action="ContractorReport" class="report-card std-card">
                        <div class="card-top">
                            <div class="icon-box">
                                <i class="fa-solid fa-user-gear"></i>
                            </div>
                            <i class="fa-solid fa-arrow-right-long card-arrow"></i>
                        </div>
                        <div class="card-info">
                            <h3>Contractor Report</h3>
                            <p>General contractor tasks, active work orders, and completion metrics.</p>
                        </div>
                    </a>

                    <!-- Profit & Loss Report -->
                    <a asp-controller="Report" asp-action="ProfitLossReport" class="report-card std-card">
                        <div class="card-top">
                            <div class="icon-box">
                                <i class="fa-solid fa-chart-line"></i>
                            </div>
                            <i class="fa-solid fa-arrow-right-long card-arrow"></i>
                        </div>
                        <div class="card-info">
                            <h3>Profit & Loss Report</h3>
                            <p>Standard financial performance, revenue streams, and net profit margins.</p>
                        </div>
                    </a>
                </div>
            </section>

            <!-- SECTION 2: Indo & Legrand Group -->
            <section class="group-section il-group">
                <div class="group-header">
                    <div class="group-header-left">
                        <div class="group-title-icon">
                            <i class="fa-solid fa-city"></i>
                        </div>
                        <h2>Indo & Legrand Reports</h2>
                    </div>
                    <span class="badge">4 Modules</span>
                </div>

                <div class="grid">
                    <!-- Contractor Report -->
                    <a asp-controller="Report" asp-action="ContractorLegrandReport" class="report-card il-card">
                        <div class="card-top">
                            <div class="icon-box">
                                <i class="fa-solid fa-users-gear"></i>
                            </div>
                            <i class="fa-solid fa-arrow-right-long card-arrow"></i>
                        </div>
                        <div class="card-info">
                            <h3>Contractor Report</h3>
                            <p>Contractor assignments specialized for Indo & Legrand divisions.</p>
                        </div>
                    </a>

                    <!-- Profit & Loss Report -->
                    <a asp-controller="Report" asp-action="ProfitLossLegrandReport" class="report-card il-card">
                        <div class="card-top">
                            <div class="icon-box">
                                <i class="fa-solid fa-scale-balanced"></i>
                            </div>
                            <i class="fa-solid fa-arrow-right-long card-arrow"></i>
                        </div>
                        <div class="card-info">
                            <h3>Profit & Loss Report</h3>
                            <p>Combined corporate income statement & dual brand financial health.</p>
                        </div>
                    </a>

                    <!-- Indo Levhi Report -->
                    <a asp-controller="Report" asp-action="CombinedSubContractorIndoListEntity" class="report-card il-card">
                        <div class="card-top">
                            <div class="icon-box">
                                <i class="fa-solid fa-bolt-lightning"></i>
                            </div>
                            <i class="fa-solid fa-arrow-right-long card-arrow"></i>
                        </div>
                        <div class="card-info">
                            <h3>Indo Levhi Report</h3>
                            <p>Dedicated equipment metrics, Levhi load data, and efficiency logs.</p>
                        </div>
                    </a>

                    <!-- Legrand Levhi Report -->
                    <a asp-controller="Report" asp-action="CombinedSubContractorEntity" class="report-card il-card">
                        <div class="card-top">
                            <div class="icon-box">
                                <i class="fa-solid fa-plug-circle-bolt"></i>
                            </div>
                            <i class="fa-solid fa-arrow-right-long card-arrow"></i>
                        </div>
                        <div class="card-info">
                            <h3>Legrand Levhi Report</h3>
                            <p>Legrand Levhi installation statuses and power diagnostics.</p>
                        </div>
                    </a>
                </div>
            </section>
        }
        else
        {
            <!-- Fancy Welcome Hero Card (No details, premium portal welcome) -->
            <div class="welcome-hero-card p-4 p-md-5 rounded-4 shadow-sm text-center text-md-start position-relative overflow-hidden" 
                 style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 60%, #0f172a 100%); border: 1px solid rgba(56, 189, 248, 0.25);">
                <!-- Ambient Glow Accents -->
                <div class="position-absolute rounded-circle" style="width: 250px; height: 250px; background: radial-gradient(circle, rgba(14, 165, 233, 0.15) 0%, rgba(0,0,0,0) 70%); top: -50px; right: -50px; pointer-events: none;"></div>
                <div class="position-absolute rounded-circle" style="width: 200px; height: 200px; background: radial-gradient(circle, rgba(99, 102, 241, 0.15) 0%, rgba(0,0,0,0) 70%); bottom: -40px; left: -40px; pointer-events: none;"></div>

                <div class="row align-items-center position-relative" style="z-index: 2;">
                    <div class="col-md-8 mb-4 mb-md-0">
                        <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill mb-3" 
                             style="background: rgba(56, 189, 248, 0.12); border: 1px solid rgba(56, 189, 248, 0.3); color: #38bdf8; font-size: 0.85rem; font-weight: 600;">
                            <i class="fa-solid fa-sparkles text-warning"></i>
                            <span>Smart Billing System Portal</span>
                        </div>
                        <h2 class="fw-bold text-white mb-2" style="font-size: 2rem; letter-spacing: -0.02em;">
                            Welcome to Smart Billing System 👋
                        </h2>
                        <p class="text-white-50 fs-6 mb-4" style="max-width: 580px; line-height: 1.6;">
                            Your account is active. Use the navigation panel to access authorized modules, manage transactions, or view your system features.
                        </p>
                        <div class="d-flex flex-wrap align-items-center justify-content-center justify-content-md-start gap-2">
                            <span class="badge bg-primary bg-opacity-25 text-info px-3 py-2 rounded-pill fs-7 fw-semibold border border-info border-opacity-25">
                                <i class="fa-solid fa-shield-halved me-1"></i> Authorized Session
                            </span>
                            <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill fs-7 fw-semibold border border-success border-opacity-25">
                                <i class="fa-solid fa-circle-check me-1"></i> System Active
                            </span>
                        </div>
                    </div>
                    <div class="col-md-4 text-center">
                        <div class="welcome-icon-illustration d-inline-flex align-items-center justify-content-center rounded-circle p-4 shadow-lg"
                             style="background: radial-gradient(circle, rgba(14, 165, 233, 0.2) 0%, rgba(30, 41, 59, 0.8) 100%); border: 2px solid rgba(56, 189, 248, 0.35); width: 130px; height: 130px;">
                            <img src="~/logo-icon.svg" alt="SBS Emblem" style="width: 75px; height: 75px; filter: drop-shadow(0 0 12px rgba(56, 189, 248, 0.5));" />
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Real-time Interactive Search Filtering -->
<script>
    document.getElementById('reportSearchInput')?.addEventListener('keyup', function () {
        const query = this.value.toLowerCase().trim();
        const tileItems = document.querySelectorAll('.report-card');

        tileItems.forEach(item => {
            const text = item.textContent.toLowerCase();
            if (text.includes(query)) {
                item.style.display = '';
            } else {
                item.style.display = 'none';
            }
        });
    });
</script>
